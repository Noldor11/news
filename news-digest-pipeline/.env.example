MAX_ARTICLES_PER_DIGEST=25
GADGET_ARTICLES_PER_DIGEST=5
MARKETPLACE_ARTICLES_PER_DIGEST=1
RSS_MAX_ARTICLE_AGE_HOURS=36

RSS_FALLBACK_MAX_ARTICLE_AGE_HOURS=72
RSS_MAX_ARTICLES_PER_SOURCE=3
RSS_FETCH_RETRIES=2
SEMANTIC_DEDUP_ENABLED=true
SEMANTIC_DEDUP_HISTORY_DAYS=30
SEMANTIC_DEDUP_MAX_PAIRS=40

# Public marketplace snapshots via Apify Cloud. Never add Upwork/Fiverr
# cookies, passwords, session IDs, or logged-in URLs.
APIFY_API_TOKEN=
APIFY_UPWORK_ENABLED=false
APIFY_UPWORK_MAX_ITEMS=30
APIFY_UPWORK_KEYWORDS=n8n Make.com Zapier AI automation AI agent
APIFY_FIVERR_ENABLED=false
APIFY_FIVERR_MAX_ITEMS=30
APIFY_FIVERR_WEEKDAY=1
APIFY_FIVERR_QUERIES=n8n automation|Make.com automation|AI agent automation
CHECK_INTERVAL_MS=60000
NODE_ENV=development

# Facebook Page
